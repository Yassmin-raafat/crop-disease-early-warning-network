          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var t = msg.temperature;\r\nvar h = msg.humidity;\r\nvar lw = msg.leaf_wetness;\r\nvar r = msg.rainfall;\r\n\r\nvar risk = \"LOW\";\r\n\r\nif (h > 85 && t >= 18 && t <= 25 && lw > 8 && r > 5) {\r\n    risk = \"CRITICAL\";\r\n}\r\nelse if (h > 85 && t >= 18 && t <= 25) {\r\n    risk = \"HIGH\";\r\n}\r\nelse if (h >= 70 && h <= 85 && t >= 15 && t <= 25) {\r\n    risk = \"MODERATE\";\r\n}\r\n\r\nmsg.risk_level = risk;\r\n\r\nreturn {\r\n    msg: msg,\r\n    metadata: metadata,\r\n    msgType: msgType\r\n};"
